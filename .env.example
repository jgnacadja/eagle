# ─── Général ───────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL (utilisé par Directus) ────────────────────────
POSTGRES_USER=learnup
POSTGRES_PASSWORD=learnup
POSTGRES_DB=learnup

# ─── Redis (cache Directus) ───────────────────────────────────
# Pas de variables dédiées : Directus s'y connecte via redis://redis:6379
# (voir docker-compose.yml). Local uniquement, pas de mot de passe.

# ─── MinIO (S3-compatible, stockage média Directus) ────────────
MINIO_ROOT_USER=learnup
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=learnup-media
# Console d'admin MinIO : http://localhost:9001

# ─── Directus (back-office) ────────────────────────────────────
# KEY/SECRET : chaînes aléatoires pour la signature interne (JWT, etc.).
# Générer en local avec `openssl rand -hex 32`. Uniquement pour le dev.
DIRECTUS_KEY=change-me-directus-key
# 32 bytes minimum (Directus avertit sinon) — valeur de dev, à régénérer
# pour tout environnement partagé.
DIRECTUS_SECRET=1cf8b5691ef007fb3c0b493bb98d37b8d197356acc4ab5d756a4dfdfb130862a
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me-admin

# ─── API (NestJS) ──────────────────────────────────────────
API_PORT=3001
# Origines autorisées par le CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000

# ─── Front (Nuxt) ──────────────────────────────────────────
NUXT_API_BASE=http://localhost:3001
NUXT_PUBLIC_API_BASE=http://localhost:3001
# NUXT_DIRECTUS_URL : utilisé par le rendu SSR (côté serveur uniquement).
# NUXT_PUBLIC_DIRECTUS_URL : utilisé par le navigateur. Diffèrent sous Docker
# (le serveur joint Directus via le nom de service `directus`).
NUXT_DIRECTUS_URL=http://localhost:8055
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
