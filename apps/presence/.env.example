# Formulaire HubSpot natif embarqué sur la page de présence.
# Les 3 premières variables sont obligatoires : si l'une manque, le formulaire
# n'est pas chargé et un message "indisponible" s'affiche à la place (pas de
# crash, pas de CTA mort).
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_ID=
# Région du compte HubSpot (ex. eu1, na1) — visible dans l'URL du portail HubSpot.
VITE_HUBSPOT_REGION=

# Optionnel — nom interne du champ HubSpot à préremplir selon le bouton profil
# cliqué (Entreprise / Particulier / Franchisé / Formateur). Par défaut "profil".
# À vérifier contre le champ réel du formulaire avant mise en prod.
VITE_HUBSPOT_PROFILE_FIELD=profil
