{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nuxt/**", ".vercel/output/**", "!.output/cache/**"]
    },
    "@learnup/front#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "!.output/cache/**"]
    },
    "@learnup/api#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@learnup/presence#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@learnup/ui#build": {
      "outputs": []
    },
    "@learnup/types#build": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "outputs": []
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    }
  }
}
