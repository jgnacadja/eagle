# Formulaire HubSpot "Contact" existant (réutilisé tel quel, non modifié) +
# tracking code HubSpot, embarqués sur la page de présence.
# Les 3 variables sont obligatoires : si l'une manque, le formulaire n'est pas
# chargé et un message "indisponible" s'affiche à la place (pas de crash, pas
# de CTA mort). Le tracking code réutilise VITE_HUBSPOT_PORTAL_ID (portalId et
# Hub ID sont le même identifiant côté HubSpot).
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_ID=
# Région du compte HubSpot (ex. eu1, na1) — visible dans l'URL du portail HubSpot.
VITE_HUBSPOT_REGION=
